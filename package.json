{
  "name": "shop-management-system",
  "private": true,
  "version": "0.1.0",
  "description": "Hybrid offline-first shop billing & management system (decoration pieces shop).",
  "scripts": {
    "dev:local-server": "pnpm --filter @shop/local-server dev",
    "dev:web": "pnpm --filter @shop/web dev",
    "dev:cloud-api": "pnpm --filter @shop/cloud-api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @shop/database exec prisma generate",
    "db:migrate": "pnpm --filter @shop/database exec prisma migrate dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
