# Cloud API — never commit the real .env (SEC-008)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/shop_cloud?schema=public"
PORT=4000

JWT_SECRET="replace-me-with-a-different-long-random-value-than-local-server"
JWT_EXPIRES_IN="12h"

# Comma-separated list of accepted device API keys (one per Local Shop
# Server that syncs to this cloud instance). In production, prefer a
# per-device row in a real table over an env list once there's more than a
# couple of shops — fine for V1's single-shop scope (docs/06-srs.md §1).
DEVICE_API_KEYS="replace-me"
