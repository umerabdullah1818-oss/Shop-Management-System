# Local Shop Server — never commit the real .env (docs/03-architecture-plan.md §8, SEC-008)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shop_local?schema=public"
PORT=3000

# Session/JWT signing secret — generate a strong random value per deployment, never reuse this.
JWT_SECRET="replace-me-with-a-long-random-value"
JWT_EXPIRES_IN="12h"

# Admin step-up override token TTL, in seconds (BR-011 / SEC-010)
OVERRIDE_TOKEN_TTL_SECONDS=120

# Cloud sync (only used by the sync worker's outbound calls — SYNC-002)
CLOUD_API_URL="https://your-cloud-host/api/v1"
CLOUD_DEVICE_API_KEY="replace-me"

# Business defaults (also editable at runtime via Settings, §57 — these are just seed values)
CASHIER_DISCOUNT_CAP_PERCENT=10
